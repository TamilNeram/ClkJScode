(function(){

            //நாழிகை அசைவூட்டங்கள் உருவாக்கு
            var இப்பொழுது       = new Date(),
            மணி = இப்பொழுது.getHours() + 6,
            மணி = மணி%24,
            நிமையம் = இப்பொழுது.getMinutes(),
            நொடி = இப்பொழுது.getSeconds(),
            மொத்தம் = நொடி + 60*நிமையம் + 3600*மணி,
            மொத்தம் = மொத்தம் *60/24;
            தற்பாரை = மொத்தம்%60,
            துளி = மொத்தம்/60,
            நாழிகை= துளி%60,
            துளி = துளி/60,
                 // நாழிகைதிசை   =  மணி/ 12 * 360 + நிமையம்/ 60 * 30,
                // துளிதிசை = நிமையம் / 60 * 360 + நொடி / 60 * 6,
                // தற்பாரைதிசை = நொடி/ 60* 360,
                நாழிகைதிசை   =  நாழிகை/ 60 * 360 + துளி/ 60 * 30,
                துளிதிசை = துளி / 60 * 360 + தற்பாரை / 60 * 6,
                தற்பாரைதிசை = தற்பாரை/ 60* 360,
                பாணிதிசை = [
                    "@-webkit-keyframes rotate-hour{from{transform:rotate(" + நாழிகைதிசை + "deg);}to{transform:rotate(" + (நாழிகைதிசை + 360) + "deg);}}",
                    "@-webkit-keyframes rotate-minute{from{transform:rotate(" + துளிதிசை + "deg);}to{transform:rotate(" + (துளிதிசை + 360) + "deg);}}",
                    "@-webkit-keyframes rotate-second{from{transform:rotate(" + தற்பாரைதிசை + "deg);}to{transform:rotate(" + (தற்பாரைதிசை + 360) + "deg);}}",
                    "@-moz-keyframes rotate-hour{from{transform:rotate(" + நாழிகைதிசை + "deg);}to{transform:rotate(" + (நாழிகைதிசை + 360) + "deg);}}",
                    "@-moz-keyframes rotate-minute{from{transform:rotate(" + துளிதிசை + "deg);}to{transform:rotate(" + (துளிதிசை + 360) + "deg);}}",
                    "@-moz-keyframes rotate-second{from{transform:rotate(" + தற்பாரைதிசை + "deg);}to{transform:rotate(" + (தற்பாரைதிசை + 360) + "deg);}}"
                ].join("");

            document.getElementById("மணி-அசைவூட்டம்").innerHTML = பாணிதிசை;

        })();

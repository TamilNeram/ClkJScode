/** தமிழாக்கம் தமிழ் நேரம் ( https://TamilNeram.github.io ) **/
body {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: #D9D7DD;
}

.மணிக்காட்டி {
  border-radius: 100%;
  background: #ffffff;
  font-family: "Montserrat";
  border: 5px solid green;
}

.முற்கள் {
  overflow: hidden;
  position: relative;
  width: 250px;
  height: 250px;
  border-radius: 100%;
}

.துளிமுள்,
.நாழிமுள் {
  position: absolute;
  height: 90px;
  width: 8px;
  margin: auto;
  top: -35%;
  left: 0;
  bottom: 0;
  right: 0;
  background: black;
  transform-origin: bottom center;
  z-index: 1;
}

.துளிமுள் {
  position: absolute;
  height: 90px;
  width: 4px;
  top: -35%;
  left: 0;
  transform: rotate(90deg);
}

.தற்பாரைமுள் {
  position: absolute;
  height: 90px;
  width: 2px;
  margin: auto;
  top: -35%;
  left: 0;
  bottom: 0;
  right: 0;
  border-radius: 4px;
  background: #FF4B3E;
  transform-origin: bottom center;
  z-index: 1;
}

.நடுமுள் {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 12px;
  height: 12px;
  border-radius: 60px;
  background: white;
  border: 2px solid #1b1b1b;
  border-radius: 100px;
  margin: auto;
  z-index: 1;
}
